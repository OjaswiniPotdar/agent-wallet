# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
# PayPal SANDBOX app credentials (only needed for --real-orders)
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# Webhook id from the sandbox app (needed for POST /webhooks/paypal; without it events are refused)
PAYPAL_WEBHOOK_ID=
# Optional: require this payee merchant id on orders and webhook events
# PAYPAL_MERCHANT_ID=
# Secret for approval fingerprints (HMAC). Set your own random value.
APPROVAL_SECRET=change-me
# Optional
# CATALOG_URL=http://localhost:8001
# LLM_TRANSPORT=httpx   # use plain HTTPS instead of the openai SDK (e.g. when its native jiter DLL is blocked)